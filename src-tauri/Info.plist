  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>es</string>
  </array>
  <key>NSMicrophoneUsageDescription</key>
  <string>To record your voice along with the screen.</string>
  <key>NSCameraUsageDescription</key>
  <string>To include the camera in the recording.</string>
</dict>
</plist>
